{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(cat)",
      "Bash(py *)",
      "PowerShell(py *)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git filter-branch *)",
      "PowerShell(git filter-branch *)",
      "Bash(git commit *--amend*)",
      "PowerShell(git commit *--amend*)",
      "Bash(git reset *--hard*)",
      "PowerShell(git reset *--hard*)",
      "Bash(git push *--force*)",
      "PowerShell(git push *--force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
